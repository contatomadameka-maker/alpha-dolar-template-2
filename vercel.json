{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/home", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/dashboard-fixed.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/videos", "destination": "/videos.html" },
    { "source": "/landing", "destination": "/landing.html" },
    { "source": "/parceiro", "destination": "/parceiro.html" },
    { "source": "/live", "destination": "/live.html" },
    { "source": "/trader", "destination": "/trader-admin.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
